model api_bank_accounts {
  id                  String   @id @default(dbgenerated("extensions.uuid_generate_v4()")) @db.Uuid
  developer_id        String   @db.Uuid
  bank_account_number String
  bank_code           String
  bank_account_name   String
  sub_account_code    String?
  created_at          DateTime @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  mode                String   @default("test")
}

model api_campaign_reports {
  id               String    @id @default(dbgenerated("extensions.uuid_generate_v4()")) @db.Uuid
  api_campaign_id  String    @db.Uuid
  reason           String
  message          String
  status           String    @default("pending")
  created_at       DateTime  @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  updated_at       DateTime  @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  developer_id     String    @db.Uuid
  api_key_id       String?   @db.Uuid
  resolution_notes String?
  resolved_at      DateTime? @db.Timestamptz(6)

  api_campaign api_campaigns @relation(fields: [api_campaign_id], references: [id])

  @@index([api_campaign_id], map: "idx_api_campaign_reports_api_campaign_id")
  @@index([developer_id], map: "idx_api_campaign_reports_developer_id")
  @@index([status], map: "idx_api_campaign_reports_status")
}

model api_campaigns {
  id                  String    @id @default(dbgenerated("extensions.uuid_generate_v4()")) @db.Uuid
  developer_id        String    @db.Uuid
  api_key_id          String?   @db.Uuid
  title               String
  description         String
  goal_amount         Decimal   @db.Decimal
  raised_amount       Decimal   @default(0) @db.Decimal
  currency            String    @default("NGN")
  status              String    @default("active")
  payout_mode         String
  deadline            DateTime? @db.Timestamptz(6)
  bank_account_number String
  bank_code           String
  bank_account_name   String
  sub_account_code    String?
  created_at          DateTime  @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  updated_at          DateTime  @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  mode                String    @default("test")
  bank_account_id     String?   @db.Uuid

  api_campaign_reports api_campaign_reports[]
}

model api_donations {
  id                 String   @id @default(dbgenerated("extensions.uuid_generate_v4()")) @db.Uuid
  api_campaign_id    String   @db.Uuid
  amount             Decimal  @db.Decimal
  tip_amount         Decimal  @default(0) @db.Decimal
  donor_name         String
  donor_email        String
  message            String?
  is_anonymous       Boolean  @default(false)
  status             String   @default("pending")
  paystack_reference String   @unique
  created_at         DateTime @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  mode               String   @default("live")

  @@index([api_campaign_id, mode], map: "idx_api_donations_campaign_mode")
  @@index([mode], map: "idx_api_donations_mode")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model api_keys {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String    @db.Uuid
  name         String
  key_prefix   String    @unique
  key_hash     String
  mode         String
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  last_used_at DateTime? @db.Timestamptz(6)
  revoked_at   DateTime? @db.Timestamptz(6)
}

model api_request_logs {
  id               String   @id @default(dbgenerated("extensions.uuid_generate_v4()")) @db.Uuid
  api_key_id       String?  @db.Uuid
  user_id          String?  @db.Uuid
  endpoint         String
  method           String
  mode             String?
  status_code      Int
  error_code       String?
  ip_address       String?
  response_time_ms Int?
  created_at       DateTime @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)

  @@index([api_key_id], map: "idx_api_request_logs_api_key_id")
  @@index([created_at(sort: Desc)], map: "idx_api_request_logs_created_at")
  @@index([endpoint], map: "idx_api_request_logs_endpoint")
}

model api_webhook_logs {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  webhook_id    String   @db.Uuid
  event_type    String
  payload       Json
  status_code   Int?
  response_body String?
  attempts      Int      @default(1)
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  webhook       api_webhooks @relation(fields: [webhook_id], references: [id])

  @@index([webhook_id], map: "idx_api_webhook_logs_webhook_id")
}

model api_webhooks {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  url        String
  secret     String
  events     String[] @default([])
  is_active  Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([user_id], map: "idx_api_webhooks_user_id")

  api_webhook_logs api_webhook_logs[]
}
