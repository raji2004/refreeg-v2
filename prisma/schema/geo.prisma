model Country {
  id         BigInt    @id @default(autoincrement())
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  country    String?   @unique
  name       String?
  latitude   Float?
  longitude  Float?

  @@map("countries")
}

model State {
  id           BigInt    @id @default(autoincrement())
  created_at   DateTime? @default(now()) @db.Timestamptz(6)
  name         String?
  countryId    BigInt?   @map("country_id")
  country_code String?
  country_name String?
  state_code   String?
  type         String?
  latitude     Float?
  longitude    Float?

  @@map("state")
}

model City {
  id           BigInt    @id
  name         String?
  stateId      BigInt?   @map("state_id")
  state_code   String?
  state_name   String?
  country_id   BigInt?
  country_code String?
  country_name String?
  latitude     Float?
  longitude    Float?
  wikiDataId   String?

  @@map("cities")
}