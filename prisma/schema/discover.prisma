/// A user's saved campaign or petition, surfaced under "Saved" and used to
/// power the bookmark toggle on Discover cards. Polymorphic on purpose —
/// causes and petitions are separate tables, so target_id is not an FK.
model bookmarks {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String   @db.Uuid
  target_type String
  target_id   String   @db.Uuid
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, target_type, target_id])
  @@index([user_id], map: "idx_bookmarks_user_id")
  @@index([target_type, target_id], map: "idx_bookmarks_target")
}

/// A saved Discover filter set a user asked to be alerted about. Persists
/// the filter snapshot only — matching new campaigns against it and
/// notifying the user is not built yet (no job/cron infra exists for it).
model saved_searches {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  label      String
  query      Json
  created_at DateTime @default(now()) @db.Timestamptz(6)
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id], map: "idx_saved_searches_user_id")
}
