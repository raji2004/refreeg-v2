model logs {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  action     String
  admin_id   String?   @db.Uuid
  created_at DateTime? @default(now()) @db.Timestamptz(6)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model short_urls {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  short_code   String    @unique @db.VarChar(10)
  entity_id    String    @db.Uuid
  entity_type  String    @db.VarChar(20)
  original_url String
  clicks       Int?      @default(0)
  created_at   DateTime? @default(now()) @db.Timestamptz(6)
  updated_at   DateTime? @default(now()) @db.Timestamptz(6)

  @@index([short_code], map: "idx_short_urls_code")
  @@index([entity_id, entity_type], map: "idx_short_urls_entity")
}

model sub_description {
  id             BigInt   @id @default(autoincrement())
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  description    String?
  sub_heading_id BigInt?

  @@map("sub-description")
}

model content_reports {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reporter_id      String?   @db.Uuid
  target_type      String    @db.VarChar(32)
  target_id        String    @db.VarChar(128)
  reported_user_id String?   @db.Uuid
  reason           String    @db.VarChar(255)
  details          String?
  status           String    @default("pending") @db.VarChar(32)
  resolution_note  String?
  reviewed_by      String?   @db.Uuid
  reviewed_at      DateTime? @db.Timestamptz(6)
  due_at           DateTime  @default(dbgenerated("(now() + '48:00:00'::interval)")) @db.Timestamptz(6)
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  updated_at       DateTime  @default(now()) @db.Timestamptz(6)

  @@index([status, due_at], map: "idx_content_reports_status_due")
  @@index([target_type, target_id], map: "idx_content_reports_target")
}

model user_blocks {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  blocker_user_id String   @db.Uuid
  blocked_user_id String   @db.Uuid
  reason          String?  @db.VarChar(255)
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  @@unique([blocker_user_id, blocked_user_id], map: "uq_user_blocks_pair")
  @@index([blocker_user_id], map: "idx_user_blocks_blocker")
}
